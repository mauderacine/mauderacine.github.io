---
// Vue « Liste » : chaque ligne déroulée verticalement, du plus récent au plus ancien.
import { projetsParLigne, urlProjet } from '../lib/projets';
import Fleche from './Fleche.astro';

const groupes = (await projetsParLigne()).filter((g) => g.projets.length > 0);
---

<div class="liste">
  {
    groupes.map((g, n) => (
      <section class="colonne" style={`--c:${g.couleur};--i:${n}`} aria-labelledby={`ligne-${g.cle}`} data-reveal>
        <header>
          <h3 id={`ligne-${g.cle}`}>{g.nom}</h3>
          <p>{g.description}</p>
        </header>
        <ol>
          {[...g.projets].reverse().map((p) => (
            <li class={p.data.statut === 'en-cours' ? 'chantier' : ''}>
              <a href={urlProjet(p)}>
                <span class="nom">
                  {p.data.titre}
                  <Fleche />
                </span>
                <span class="resume">{p.data.resume}</span>
                <span class="meta">
                  {p.data.periode}
                  {p.data.statut === 'en-cours' && <span>En cours</span>}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

<style>
  .liste {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 56px clamp(24px, 4vw, 56px);
  }
  header {
    display: grid;
    gap: 4px;
    padding-bottom: 16px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--encre);
  }
  header h3 {
    font-size: 1.5rem;
  }
  header p {
    color: var(--gris);
    font-size: 0.9375rem;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  /* la ligne verticale */
  ol::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 24px;
    bottom: 24px;
    width: 4px;
    background: var(--c);
  }
  li {
    position: relative;
    padding-left: 34px;
  }
  /* la station */
  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 19px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--fond);
    border: 3px solid var(--c);
    box-sizing: border-box;
    transition:
      transform 0.4s var(--doux),
      background-color 0.3s;
  }
  li.chantier::before {
    border-style: dashed;
    border-width: 2px;
  }
  li:has(a:hover)::before,
  li:has(a:focus-visible)::before {
    transform: scale(1.3);
    background: var(--c);
  }
  a {
    display: grid;
    gap: 4px;
    padding: 14px 0 18px;
    text-decoration: none;
    border-bottom: 1px solid var(--trait);
  }
  .nom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .nom :global(svg) {
    flex: 0 0 auto;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.3s,
      transform 0.4s var(--doux);
  }
  a:hover .nom :global(svg),
  a:focus-visible .nom :global(svg) {
    opacity: 1;
    transform: none;
  }
  .resume {
    color: var(--gris);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    gap: 14px;
    font-size: 0.8125rem;
    color: var(--gris);
    margin-top: 2px;
  }
</style>
